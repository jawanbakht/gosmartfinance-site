---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Pagina niet gevonden | Go Smart finance" description="Deze pagina bestaat niet (meer).">
  <section class="bg-navy-950 text-white py-[clamp(80px,12vw,160px)]">
    <div class="wrap grid gap-6 max-w-[760px]">
      <span class="eyebrow text-ink-dark-2 num">404</span>
      <h1 class="text-display">Deze pagina sluit niet aan.</h1>
      <p class="text-ink-dark-2">Het adres bestaat niet (meer). Misschien zoek je een van deze pagina's.</p>
      <div class="pt-2 flex flex-wrap gap-4">
        <Button href="/" variant="accent" arrow>Naar home</Button>
        <Button href="/diensten" variant="secondary" onDark>Diensten</Button>
        <Button href="/contact" variant="secondary" onDark>Contact</Button>
      </div>
    </div>
  </section>
</Base>
