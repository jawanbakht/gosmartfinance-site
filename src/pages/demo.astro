---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SampleBadge from "../components/SampleBadge.astro";
import ClosingCta from "../components/home/ClosingCta.astro";
import { compute, kpisHtml, tableHtml, barsHtml, cashSvg, summaryText, ENTITY_LABEL, PERIOD_LABEL } from "../lib/demo";

const d = compute("totaal", "jaar");
const chip =
  "font-medium text-[14px] leading-none px-3.5 py-2.5 rounded-full border border-line bg-white text-ink cursor-pointer transition-colors hover:border-navy-950 aria-pressed:bg-navy-950 aria-pressed:border-navy-950 aria-pressed:text-white";
---
<Base
  title="Demo-dashboard | Go Smart finance"
  description="Klik zelf door een finance-dashboard met KPI's, variantieanalyse en cashflowprognose. Met voorbeelddata van een fictief bedrijf."
>
  <PageHeader
    eyebrow="Demo"
    title="Klik zelf door een dashboard."
    intro="Kies een periode en een entiteit. KPI's, grafieken en de variantietabel rekenen direct mee. Alle cijfers zijn voorbeelddata van een fictief bedrijf."
  >
    <div><SampleBadge onDark /></div>
  </PageHeader>

  <section class="bg-mist py-[clamp(40px,6vw,80px)]" aria-label="Demo-dashboard">
    <div class="wrap grid gap-6">
      <div class="flex flex-wrap gap-x-10 gap-y-4 items-center rounded-[var(--radius-card)] border border-line bg-white p-4">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Periode">
          <span class="eyebrow text-ink-2 mr-1">Periode</span>
          {Object.entries(PERIOD_LABEL).map(([k, l]) => (
            <button type="button" class={chip} data-period={k} aria-pressed={k === "jaar" ? "true" : "false"}>{l}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Entiteit">
          <span class="eyebrow text-ink-2 mr-1">Entiteit</span>
          {Object.entries(ENTITY_LABEL).map(([k, l]) => (
            <button type="button" class={chip} data-entity={k} aria-pressed={k === "totaal" ? "true" : "false"}>{l}</button>
          ))}
        </div>
      </div>

      <p id="demo-summary" class="text-ink-2 text-[15px]" aria-live="polite">{summaryText(d, "totaal", "jaar")}</p>

      <div id="demo-kpis" class="grid grid-cols-2 lg:grid-cols-4 gap-3" set:html={kpisHtml(d)}></div>

      <div class="grid gap-6 lg:grid-cols-2">
        <figure class="grid gap-4 min-w-0 rounded-[var(--radius-card)] border border-line bg-white p-[clamp(16px,2.4vw,28px)]">
          <figcaption class="flex flex-wrap justify-between gap-2 items-baseline">
            <span class="font-semibold">Omzet tegen budget <span class="text-ink-2 font-normal">· k€</span></span>
            <span class="text-sm text-ink-2">Voorbeelddata</span>
          </figcaption>
          <ul class="flex flex-wrap gap-4 text-[13px] text-ink-2" aria-hidden="true">
            <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-d1"></span>Realisatie</li>
            <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-d3"></span>Budget</li>
            <li class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-accent-on-light"></span>Grootste afwijking</li>
          </ul>
          <svg id="demo-bars" class="chart w-full h-auto block transition-opacity duration-300" viewBox="0 0 900 300" role="img" aria-label="Staafgrafiek omzet tegen budget per maand voor de gekozen periode" set:html={barsHtml(d)}></svg>
        </figure>

        <figure class="grid gap-4 min-w-0 rounded-[var(--radius-card)] border border-line bg-white p-[clamp(16px,2.4vw,28px)]">
          <figcaption class="flex flex-wrap justify-between gap-2 items-baseline">
            <span class="font-semibold">Kaspositie per maandeinde <span class="text-ink-2 font-normal">· k€</span></span>
            <span class="text-sm text-ink-2">Gekozen periode gemarkeerd</span>
          </figcaption>
          <svg id="demo-cash" class="chart w-full h-auto block transition-opacity duration-300" viewBox="0 0 900 260" role="img" aria-label="Lijngrafiek kaspositie over twaalf maanden" set:html={cashSvg(d)}></svg>
        </figure>
      </div>

      <figure class="grid gap-4 min-w-0 rounded-[var(--radius-card)] border border-line bg-white p-[clamp(16px,2.4vw,28px)]">
        <figcaption class="flex flex-wrap justify-between gap-2 items-baseline">
          <span class="font-semibold">Resultaat tegen budget <span class="text-ink-2 font-normal">· k€</span></span>
          <span class="text-sm text-ink-2">▲ gunstig · ▼ ongunstig</span>
        </figcaption>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[480px] text-[15px] num border-collapse">
            <caption class="sr-only">Resultaat tegen budget voor de gekozen periode en entiteit, voorbeelddata</caption>
            <thead>
              <tr class="text-xs uppercase tracking-[.06em] text-ink-2">
                <th scope="col" class="text-left font-semibold py-2 pr-3">Post</th>
                <th scope="col" class="text-right font-semibold py-2 pr-3">Realisatie</th>
                <th scope="col" class="text-right font-semibold py-2 pr-3">Budget</th>
                <th scope="col" class="text-right font-semibold py-2">Verschil</th>
              </tr>
            </thead>
            <tbody id="demo-table" class="text-ink-2" set:html={tableHtml(d)}></tbody>
          </table>
        </div>
      </figure>
    </div>
  </section>

  <section class="py-section" aria-labelledby="demo-next" data-reveal>
    <div class="wrap grid gap-5 max-w-[760px]">
      <hr class="border-0 border-t border-ink" />
      <h2 id="demo-next" class="text-h2">Dit is een voorbeeld. Jouw dashboard draait op jouw cijfers.</h2>
      <p class="text-ink-2">Een dashboard wordt ingericht op jouw KPI's, rekeningschema en kostenplaatsen.</p>
    </div>
  </section>

  <ClosingCta />
</Base>

<script>
  import { compute, kpisHtml, tableHtml, barsHtml, cashSvg, summaryText, type Entity, type Period } from "../lib/demo";

  let entity: Entity = "totaal";
  let period: Period = "jaar";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const $ = (id: string) => document.getElementById(id)!;

  function render() {
    const d = compute(entity, period);
    const charts = [$("demo-bars"), $("demo-cash")];
    const apply = () => {
      $("demo-kpis").innerHTML = kpisHtml(d);
      $("demo-table").innerHTML = tableHtml(d);
      $("demo-bars").innerHTML = barsHtml(d);
      $("demo-cash").innerHTML = cashSvg(d);
      $("demo-summary").textContent = summaryText(d, entity, period);
      charts.forEach((c) => (c.style.opacity = "1"));
    };
    if (reduce) return apply();
    charts.forEach((c) => (c.style.opacity = "0.35"));
    setTimeout(apply, 150);
  }

  function bind(attr: "data-period" | "data-entity") {
    const btns = document.querySelectorAll<HTMLButtonElement>(`[${attr}]`);
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        if (attr === "data-period") period = b.dataset.period as Period;
        else entity = b.dataset.entity as Entity;
        render();
      }),
    );
  }
  bind("data-period");
  bind("data-entity");
</script>

<style>
  .chart :global(text) { font-family: var(--font-sans); font-size: 12px; font-variant-numeric: tabular-nums; }
</style>
