---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import Recognition from "../components/home/Recognition.astro";
import Services from "../components/home/Services.astro";
import DemoTeaser from "../components/home/DemoTeaser.astro";
import Founder from "../components/home/Founder.astro";
import Faq from "../components/home/Faq.astro";
import ClosingCta from "../components/home/ClosingCta.astro";

const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Go Smart finance",
  slogan: "Time is Gold",
  url: "https://www.gosmartfinance.com/",
  email: "info@gosmartfinance.com",
  founder: { "@type": "Person", name: "Sakhi Jawanbakht" },
  address: { "@type": "PostalAddress", addressLocality: "Zoetermeer", addressCountry: "NL" },
};
---
<Base
  title="AI-tools en dashboards voor finance | Go Smart finance"
  description="Minder handwerk in maandafsluiting, reconciliatie en rapportage. AI-tools en dashboards voor controllers en CFO's, gebouwd door een financial."
>
  <Hero />
  <Recognition />
  <Services />
  <DemoTeaser />
  <Founder />
  <Faq />
  <ClosingCta />
  <script type="application/ld+json" set:html={JSON.stringify(org)}></script>
</Base>
