---
// Diensten: vier korte regels links, één groot visual rechts dat wisselt (desktop).
// Op mobiel staat het visual direct onder elke dienst.
import SampleBadge from "../SampleBadge.astro";
import { services } from "../../data/services";
---
<section class="py-section bg-mist" aria-labelledby="svc-title" data-reveal>
  <div class="wrap">
    <div class="grid gap-5 max-w-[720px] mb-12">
      <hr class="border-0 border-t border-ink" />
      <span class="eyebrow text-ink-2">Diensten</span>
      <h2 id="svc-title" class="text-h2">Vier stukken handwerk die verdwijnen.</h2>
      <p class="text-ink-2">Elke module neemt een concreet stuk werk over. Jij houdt de controle over de uitkomst.</p>
    </div>

    <div class="grid gap-10 md:grid-cols-[5fr_7fr] items-start">
      <div class="grid gap-0" data-svc-list>
        {services.map((s, i) => (
          <div class="border-t border-line last:border-b">
            <!-- Mobiel: gewone kop + tekst. Desktop: knop die het visual rechts kiest (aria-pressed). -->
            <div class="md:hidden grid gap-2 py-6">
              <h3 class="text-[22px] font-semibold tracking-[-0.02em]">{s.title}</h3>
              <p class="text-ink-2 text-[16px] leading-relaxed">{s.text}</p>
            </div>
            <button
              type="button"
              aria-pressed={i === 0 ? "true" : "false"}
              aria-controls={`panel-${s.id}`}
              class="group hidden md:grid w-full text-left py-6 cursor-pointer gap-2 pl-5 border-l-2 border-transparent aria-pressed:border-accent-on-light transition-colors"
            >
              <span class="text-[22px] font-semibold tracking-[-0.02em] text-ink-2 group-aria-pressed:text-ink group-hover:text-ink transition-colors">{s.title}</span>
              <span class="text-ink-2 text-[16px] leading-relaxed">{s.text}</span>
            </button>
            <figure class="md:hidden grid gap-3 pb-8 min-w-0">
              <div class="rounded-[var(--radius-card)] border border-line bg-white p-4 min-w-0"><s.Visual /></div>
              <figcaption class="text-sm text-ink-2">{s.caption}</figcaption>
            </figure>
          </div>
        ))}
        <a href="/diensten" class="mt-8 justify-self-start font-semibold text-navy-950 border-b border-line pb-0.5 hover:border-accent-on-light transition-colors">Alle diensten uitgewerkt</a>
      </div>

      <div class="hidden md:block md:sticky md:top-28 min-w-0">
        {services.map((s, i) => (
          <figure
            id={`panel-${s.id}`}
            hidden={i !== 0}
            class="svc-panel grid gap-5 rounded-[var(--radius-card)] border border-line bg-white p-[clamp(16px,2.4vw,28px)] min-w-0"
          >
            <figcaption class="flex flex-wrap justify-between gap-3 items-baseline">
              <span class="font-semibold">{s.caption}</span>
              <SampleBadge />
            </figcaption>
            <s.Visual />
          </figure>
        ))}
      </div>
    </div>
    <p class="md:hidden mt-2"><SampleBadge /></p>
  </div>
</section>

<script>
  // Desktop: knoppen kiezen welk visual rechts staat. Gewone knoppen met aria-pressed, Tab/Enter werkt.
  const list = document.querySelector<HTMLElement>("[data-svc-list]");
  if (list) {
    const btns = Array.from(list.querySelectorAll<HTMLButtonElement>("button[aria-controls]"));
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        btns.forEach((x) => {
          const on = x === b;
          x.setAttribute("aria-pressed", String(on));
          const panel = document.getElementById(x.getAttribute("aria-controls")!);
          if (panel) {
            panel.hidden = !on;
            if (on) panel.classList.add("svc-in");
          }
        });
      }),
    );
  }
</script>

<style>
  .svc-panel:global(.svc-in) { animation: svc-fade .3s var(--ease-calm); }
  @keyframes svc-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>
